# ─── Identifiants CESAL (utilisés seulement pour le login semi-manuel) ───
CESAL_EMAIL=simon5.amar@gmail.com
CESAL_PASSWORD=

# ─── Telegram ───
# 1. Parle à @BotFather sur Telegram -> /newbot -> copie le token ici
TELEGRAM_BOT_TOKEN=
# 2. Parle à @userinfobot pour obtenir ton chat id
TELEGRAM_CHAT_ID=

# ─── Comportement ───
# alert   = détecte + notifie seulement (TU réserves)   <-- défaut sûr
# reserve = détecte + réserve automatiquement           <-- à activer quand tu es prêt
MODE=alert

# Date de sortie à écrire dans le datepicker (format dd/mm/yyyy)
DATE_SORTIE=18/12/2026

# Intervalle de vérification, en SECONDES (prioritaire sur INTERVAL_MINUTES).
# 3 s partout, local ET VPS. Inutile de descendre plus bas : le site met
# lui-même 1,8 à 3,3 s à répondre à un check.
INTERVAL_SECONDS=3

# Headless: true en serveur, false pour voir le navigateur (debug / 1er login)
HEADLESS=true

# ─── Exécution locale (sur ton Mac, EN PLUS du VPS) ───
# Ces 3 variables ne servent qu'en local — ne les mets PAS en secret Fly.
# Le plus simple est de passer par le Makefile : `make run-warm`.

# Nom préfixé à chaque message Telegram. Quand le Mac et le VPS tournent tous
# les deux, ils écrivent dans le même chat : sans ça, impossible de savoir
# laquelle des deux instances a parlé (ni laquelle a réservé).
INSTANCE_NAME=

# true = le Chromium de la réservation s'ouvre VISIBLE à l'écran. Le site
# (jQuery/select2/AJAX) répond mieux dans une vraie fenêtre, et tu peux
# reprendre la main à la souris. Sans effet sur le VPS (aucun affichage).
SHOW_BROWSER=false

# true = garde une fenêtre ouverte EN PERMANENCE sur la page de réservation,
# déjà connectée. La surveillance reste en HTTP pur ; c'est la réservation qui
# démarre à chaud. Mesuré contre le vrai site : ~2800 ms à froid → ~14 ms.
# À n'activer qu'en local (le VPS n'a pas la RAM pour un Chromium résident).
WARM_WINDOW=false

# Rafraîchissement de la fenêtre chaude, en secondes. Sert UNIQUEMENT à garder
# la session vivante — ce n'est PAS la fréquence de détection (c'est le rôle du
# fetch HTTP, cf. INTERVAL_SECONDS). Inutile de descendre bas.
WARM_REFRESH_SECONDS=120

# ─── Choix du logement quand PLUSIEURS sont dispos en même temps ───
# Toutes ces variables sont lisibles en secret Fly (fly secrets set …) sans
# redéployer. Test hors ligne du résultat : npm run test:selection

# Résidences réellement auto-réservées (les autres = alerte seule).
# L'ORDRE compte : à type et prix égaux, la 1re listée gagne.
AUTO_RESERVE_RESIDENCES=3,4

# Ordre de préférence des types (le 1er = celui qu'on veut vraiment).
PREFERRED_TYPES=T1,T1 BIS,T2

# true = ne réserver QUE les types ci-dessus (les autres sont juste signalés).
STRICT_TYPES=false

# true = accepter aussi une colocation NON solidaire (le site ne demande alors
# aucun email de colocataire). false = uniquement du 100 % individuel.
ALLOW_COLOC_NON_SOLIDAIRE=false

# Si le site refuse le 1er choix, nombre max de logements DIFFÉRENTS tentés
# dans le même cycle.
MAX_CANDIDATES_PER_CYCLE=3

# ─── Réservation ───
# Tentatives max SUR UN MÊME logement, par jour. Une tentative ratée ne clôt
# PAS l'affaire : le bot réessaie au cycle suivant tant qu'il n'a rien décroché.
MAX_RESERVE_ATTEMPTS=5

# Si la validation HTTP n'aboutit pas, rejouer le parcours dans un vrai
# navigateur (il exécute le JavaScript du site et sa popup de confirmation).
# Mettre à false seulement si la machine est trop petite pour Chromium.
BROWSER_FALLBACK=true
